model AuditException {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToAuditException", fields: [propertyId], references: [id], onDelete: Cascade)
  
  auditRunId String   @db.ObjectId
  auditRun   AuditRun @relation("AuditRunToAuditException", fields: [auditRunId], references: [id], onDelete: Cascade)
  
  type       String   // e.g. "UNPOSTED_TAX", "MISMATCHED_PAYMENT", "UNAUTHORIZED_VOID"
  severity   String   // HIGH, MEDIUM, LOW
  
  transactionId String? @db.ObjectId 
  bookingId     String? @db.ObjectId
  booking       Booking? @relation("BookingToAuditException", fields: [bookingId], references: [id])
  
  status     ExceptionStatus @default(PENDING) // PENDING, RESOLVED
  
  resolvedById String? @db.ObjectId
  resolvedBy   User?   @relation("UserToAuditExceptionResolved", fields: [resolvedById], references: [id])
  
  resolutionNotes String?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@map("audit_exceptions")
}

model ERPSyncLog {
