// Zenbourg Hotel Management System - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ========================================
// USERS & AUTHENTICATION
// ========================================

model User {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String     @unique
  phone    String?    @unique
  password String
  role     UserRole
  status   UserStatus @default(ACTIVE)
  dndEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workplaceId String?   @db.ObjectId
  myWorkplace Property? @relation("WorkerRelation", fields: [workplaceId], references: [id])

  ownedPropertyIds String[]   @db.ObjectId
  ownedProperties  Property[] @relation("OwnershipRelation", fields: [ownedPropertyIds], references: [id])
  staffProfile     Staff?

  requestedBookingRequests BookingRequest[] @relation("RequestedBy")
  approvedBookingRequests  BookingRequest[] @relation("ApprovedBy")
  rejectedBookingRequests  BookingRequest[] @relation("RejectedBy")

  postedTransactions   LedgerTransaction[] @relation("UserToLedgerTransaction")
  startedAuditRuns     AuditRun[]          @relation("UserToAuditRunStarted")
  resolvedExceptions   AuditException[]    @relation("UserToAuditExceptionResolved")

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  HOTEL_ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

// ========================================
// GUESTS
// ========================================

model Guest {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String?
  profileImage    String?
  phone           String    @unique
  idType          String?
  idNumber        String?
  idDocumentFront String?
  idDocumentBack  String?
  address         String?
  dateOfBirth     DateTime?
  gstNumber       String?   // Guest / Corporate GSTIN (e.g. 27ABCDE1234F1ZH)

  checkInStatus      CheckInStatus @default(PENDING)
  checkInCompletedAt DateTime?

  language String @default("English")

  // Track which property created/owns this guest profile
  createdByPropertyId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings        Booking[]
  serviceRequests ServiceRequest[]
  supportTickets  SupportTicket[]
  ratings         Rating[]
  favorites       Favorite[]

  lostItems LostItem[]

  @@map("guests")
}

model Favorite {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  guestId String @db.ObjectId
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  roomId String @db.ObjectId
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guestId, roomId])
  @@map("favorites")
}

enum CheckInStatus {
  PENDING
  LINK_SENT
  LINK_OPENED
  COMPLETED
  VERIFIED
}

// ========================================
// PROPERTIES & ROOMS
// ========================================

model Property {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  address     String
  phone       String
  email       String
  logo        String?
  coverImage  String?
  images      String[]

  // Operating Hours
  checkInTime  String @default("14:00")
  checkOutTime String @default("11:00")

  // Policies
  cancellationPolicy String?
  // Subscription Model
  plan               SubscriptionPlan @default(BASE)
  features           String[]         @default(["BASIC_OPS", "STAFF_MANAGEMENT"])
  planExpiresAt      DateTime?
  isTrialActive      Boolean          @default(false)
  isAutopayActive    Boolean          @default(false)
  customQuoteAmount  Float?
  customQuoteStatus  String?          @default("NONE") // NONE, PENDING, APPROVED, PAID
  customQuoteAllowsTrial Boolean          @default(false)


  latitude    Float?
  longitude   Float?
  ranking     Int      @default(0) // Higher value = better ranking/SEO
  policies    Json? // Flexible JSON for various policies

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownerIds String[] @db.ObjectId
  owners   User[]   @relation("OwnershipRelation", fields: [ownerIds], references: [id])

  workerList      User[]           @relation("WorkerRelation")
  rooms           Room[]           @relation("PropertyToRoom")
  amenities       Amenity[]        @relation("PropertyToAmenity")
  menuItems       MenuItem[]       @relation("PropertyToMenuItem")
  spaServices     SpaService[]     @relation("PropertyToSpaService")
  staff           Staff[]          @relation("PropertyToStaff")
  bookings        Booking[]        @relation("PropertyToBooking")
  serviceRequests ServiceRequest[] @relation("PropertyToServiceRequest")
  rolePermissions RolePermission[] @relation("PropertyToRolePermission")
  serviceConfigs  ServiceConfig[]  @relation("PropertyToServiceConfig")
  campaigns       Campaign[]       @relation("PropertyToCampaign")
  systemNodes     SystemNode[]     @relation("PropertyToSystemNode")
  systemAlerts    SystemAlert[]    @relation("PropertyToSystemAlert")
  supportTickets  SupportTicket[]  @relation("PropertyToSupportTicket")
  lostItems       LostItem[]       @relation("PropertyToLostItem")
  dashboardServices DashboardService[] @relation("PropertyToDashboardService")
  otaConnections  OtaConnection[]  @relation("PropertyToOtaConnection")
  mealPlans       MealPlan[]       @relation("PropertyToMealPlan")

  ledgerTransactions LedgerTransaction[] @relation("PropertyToLedgerTransaction")
  erpIntegrations    ERPIntegration[]    @relation("PropertyToERPIntegration")

  auditRuns          AuditRun[]          @relation("PropertyToAuditRun")
  auditExceptions    AuditException[]    @relation("PropertyToAuditException")
  erpSyncLogs        ERPSyncLog[]        @relation("PropertyToERPSyncLog")

  // Procurement & Concierge Ops
  vendors            Vendor[]            @relation("PropertyToVendor")
  purchaseOrders     PurchaseOrder[]     @relation("PropertyToPurchaseOrder")

  @@map("properties")
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToRoom", fields: [propertyId], references: [id], onDelete: Cascade)

  roomNumber String
  floor      Int
  category   RoomCategory
  type       String // Standard King, Deluxe Twin, etc.

  maxOccupancy Int
  basePrice    Float
  weekendSurcharge Float @default(0)

  visibleOnline  Boolean @default(true)
  petFriendly    Boolean @default(false)
  smokingAllowed Boolean @default(false)
  adaCompliant   Boolean @default(false)

  amenities   String[]
  images      String[]
  description String?

  status RoomStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings        Booking[]
  serviceRequests ServiceRequest[]
  favorites       Favorite[]
  lostItems       LostItem[]
  otaMappings     RoomOtaMapping[] @relation("RoomToOtaMapping")

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@index([status])
  @@map("rooms")
}

enum RoomCategory {
  STANDARD
  DELUXE
  SUITE
  PENTHOUSE
  CUSTOM
  EXECUTIVE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  BOOKED
  MAINTENANCE
  BLOCKED
  CLEANING
}

// ========================================
// BOOKINGS
// ========================================

model Booking {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  guestId String @db.ObjectId
  guest   Guest  @relation(fields: [guestId], references: [id])

  roomId String @db.ObjectId
  room   Room   @relation(fields: [roomId], references: [id])

  checkIn  DateTime
  checkOut DateTime

  actualCheckIn  DateTime?
  actualCheckOut DateTime?

  numberOfGuests Int

  status BookingStatus @default(RESERVED)
  source BookingSource @default(DIRECT)

  totalAmount   Float
  paidAmount    Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?       // CASH, CARD, ONLINE, CORPORATE_CLEARANCE, OTHER

  // Tax & Charges breakdown (applied at booking time from PropertySettings)
  baseAmount         Float?   // Room rate × nights (before tax)
  gstPercent         Float?   // GST % applied
  gstAmount          Float?   // GST amount
  serviceChargePercent Float? // Service charge %
  serviceChargeAmount Float?  // Service charge amount
  luxuryTaxPercent   Float?   // Luxury tax %
  luxuryTaxAmount    Float?   // Luxury tax amount
  discountPercent    Float?   // Discount %
  discountAmount     Float?   // Discount amount
  finalAmount        Float?   // totalAmount after all taxes & discounts
  guestGstNumber     String?  // Guest GSTIN for B2B tax invoice

  // Meal plan
  mealPlan            String?  // EP, CP, MAP, AP
  mealPlanPricePerDay Float?   // Per-day price override
  mealPlanAmount      Float?   // Total meal plan cost (pricePerDay × nights)

  // Extra add-ons & requests (extra bed, extra mattress, custom services)
  extraAddons         Json?    // Array of { id, name, price, qty }
  extraAddonsAmount   Float?   @default(0)

  specialRequests String?
  notes           String?

  propertyId String?  @db.ObjectId
  property   Property? @relation("PropertyToBooking", fields: [propertyId], references: [id])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lostItems LostItem[]
  requests  BookingRequest[]
  
  ledgerTransactions LedgerTransaction[] @relation("BookingToLedgerTransaction")
  auditExceptions    AuditException[]    @relation("BookingToAuditException")
  purchaseOrders     PurchaseOrder[]     @relation("BookingToPurchaseOrder")

  @@index([propertyId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@index([createdAt])
  @@map("bookings")
}

// ========================================
// BOOKING REQUESTS (Upgrade/Extend)
// ========================================

model BookingRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId String   @db.ObjectId
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type      BookingRequestType
  status    ApprovalStatus     @default(PENDING)

  // Request Details
  // For upgrades: { newRoomId: string, extraCharge: number }
  // For extensions: { newCheckOut: Date, extraCharge: number }
  details   Json 

  requestedById String @db.ObjectId
  requestedBy   User   @relation("RequestedBy", fields: [requestedById], references: [id])

  approvedById  String? @db.ObjectId
  approvedBy    User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  rejectedById  String? @db.ObjectId
  rejectedBy    User?   @relation("RejectedBy", fields: [rejectedById], references: [id])

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("booking_requests")
}

enum BookingRequestType {
  UPGRADE
  EXTENSION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WALK_IN
  DIRECT
  BOOKING_COM
  MAKE_MY_TRIP
  AGODA
  EXPEDIA
  AIRBNB
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

// ========================================
// SERVICES & ORDERS
// ========================================

model ServiceRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  type ServiceType

  guestId String? @db.ObjectId
  guest   Guest?  @relation(fields: [guestId], references: [id])

  roomId String? @db.ObjectId
  room   Room?   @relation(fields: [roomId], references: [id])

  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToServiceRequest", fields: [propertyId], references: [id])

  title       String
  description String?
  priority    Priority @default(NORMAL)

  assignedToId String? @db.ObjectId
  assignedTo   Staff?  @relation(fields: [assignedToId], references: [id])

  status ServiceStatus @default(PENDING)

  // SLA Tracking
  slaMinutes  Int       @default(60) // Default 60 minutes
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // Payment (for food orders)
  amount        Float?
  paymentStatus PaymentStatus?

  attachments String[]
  notes       String?

  updatedAt DateTime @updatedAt

  // Relations
  ratings  Rating[]
  messages Message[] @relation("ServiceMessages")

  @@index([propertyId])
  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("service_requests")
}

enum ServiceType {
  HOUSEKEEPING
  FOOD_ORDER
  ROOM_SERVICE
  LAUNDRY
  MAINTENANCE
  CONCIERGE
  SPA
  WAKEUP
  TOILETRIES
}

enum ServiceStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ========================================
// STAFF & HR
// ========================================

model Staff {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToStaff", fields: [propertyId], references: [id], onDelete: Cascade)

  employeeId    String    @unique
  dateOfBirth   DateTime?
  dateOfJoining DateTime  @default(now())

  department   Department
  designation  String
  contractType String?
  workShift    String?
  managerName  String?

  // Compensation
  baseSalary    Float
  bankName      String?
  accountNumber String?
  ifscCode      String?

  // Emergency Contact
  emergencyContactName  String?
  emergencyContactPhone String?

  address      String?
  profilePhoto String?
  documents    Json? // Store various documents

  // Leave Balances
  annualLeaveBalance Int @default(15)
  sickLeaveBalance   Int @default(10)
  casualLeaveBalance Int @default(7)

  isVerified            Boolean @default(false)
  verificationRequested Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  serviceRequests   ServiceRequest[]
  payrolls          Payroll[]
  financialAdjustments StaffFinancialAdjustment[]
  performanceScores PerformanceScore[]
  lostItems         LostItem[]

  @@index([propertyId])
  @@index([department])
  @@map("staff")
}

// ========================================
// STAFF FINANCIAL ADJUSTMENTS
// ========================================

model StaffFinancialAdjustment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  staffId   String   @db.ObjectId
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  type      AdjustmentType // INCENTIVE, BONUS, ALLOWANCE, DEDUCTION
  amount    Float
  reason    String?
  month     String // Format: MMMM (e.g., "March")
  year      Int
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, month, year])
  @@map("staff_financial_adjustments")
}

enum AdjustmentType {
  INCENTIVE
  BONUS
  ALLOWANCE
  DEDUCTION
}

enum Department {
  FRONT_DESK
  HOUSEKEEPING
  KITCHEN
  ROOM_SERVICE
  MAINTENANCE
  SECURITY
  ACCOUNTS
  MANAGEMENT
  SPA
  LAUNDRY
}

// ========================================
// ATTENDANCE
// ========================================

model Attendance {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  staffId String @db.ObjectId
  staff   Staff  @relation(fields: [staffId], references: [id])

  date DateTime

  punchIn  DateTime?
  punchOut DateTime?

  punchInLocation  String?
  punchOutLocation String?

  status AttendanceStatus @default(ABSENT)

  // Working Hours
  hoursWorked   Float?
  overtimeHours Float  @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([date])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

// ========================================
// LEAVE MANAGEMENT
// ========================================

model LeaveRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  staffId String @db.ObjectId
  staff   Staff  @relation(fields: [staffId], references: [id])

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  totalDays Int

  reason String

  status LeaveStatus @default(PENDING)

  approvedBy String?
  approvedAt DateTime?

  rejectionReason String?
  evidence        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leave_requests")
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ========================================
// PAYROLL & INCENTIVES
// ========================================

model Payroll {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  staffId String @db.ObjectId
  staff   Staff  @relation(fields: [staffId], references: [id])

  month String // Format: YYYY-MM
  year  Int

  // Salary Components
  baseSalary  Float
  overtimePay Float @default(0)
  incentives  Float @default(0)
  bonuses     Float @default(0)
  deductions  Float @default(0)
  netSalary   Float

  // Status
  status    PayrollStatus @default(PENDING)
  paidAt    DateTime?
  paymentId String?
  transactionId String?
  bankDetails   Json?

  // Calculations Breakdown
  breakdown Json? // Detailed breakdown of calculations
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, month, year])
  @@map("payrolls")
}

enum PayrollStatus {
  PENDING
  APPROVED
  PAID
}

// ========================================
// PERFORMANCE & RATINGS
// ========================================

model Rating {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  guestId String @db.ObjectId
  guest   Guest  @relation(fields: [guestId], references: [id])

  serviceRequestId String?         @db.ObjectId
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  // Can be for service or overall stay
  type RatingType

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())

  @@map("ratings")
}

enum RatingType {
  SERVICE
  OVERALL_STAY
  CLEANLINESS
  FOOD
  STAFF
}

model PerformanceScore {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  staffId String @db.ObjectId
  staff   Staff  @relation(fields: [staffId], references: [id])

  month String // Format: YYYY-MM
  year  Int

  // Metrics
  tasksCompleted Int    @default(0)
  tasksOnTime    Int    @default(0)
  avgRating      Float?
  slaBreaches    Int    @default(0)

  // Calculated Score
  overallScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, month, year])
  @@map("performance_scores")
}

// ========================================
// HOTEL CONTENT
// ========================================

model Amenity {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToAmenity", fields: [propertyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  icon        String?
  category    String? // Pool, Gym, Spa, etc.
  options     Json?   // List of sub-options: [{label: string, price?: number, duration?: number}]
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("amenities")
}

model MenuItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToMenuItem", fields: [propertyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String // Breakfast, Lunch, Dinner, Beverages
  cuisine     String? // Indian, Chinese, Continental, etc.

  price  Float
  margin Float @default(0)
  images String[]

  isVeg       Boolean @default(true)
  isAvailable Boolean @default(true)

  prepTime Int? // In minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([propertyId])
  @@index([category])
  @@map("menu_items")
}

model SpaService {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToSpaService", fields: [propertyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  duration    Int // In minutes
  price       Float
  image       String?

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spa_services")
}

model LostItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToLostItem", fields: [propertyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String // ELECTRONICS, CLOTHING, PERSONAL, etc.
  status      String  @default("FOUND") // FOUND, CLAIMED, DISPOSED

  foundDate DateTime @default(now())
  location  String?

  roomId String? @db.ObjectId
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  reportedById String? @db.ObjectId
  reportedBy   Staff?  @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  // Guest & Booking for tracking
  guestId   String?  @db.ObjectId
  guest     Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  bookingId String?  @db.ObjectId
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  image            String? // Primary Thumbnail
  evidenceImages   String[]
  caseNotes        Json? // List of {note: string, author: string, createdAt: Date}

  // Claim Details
  claimerName  String?
  claimerPhone String?
  claimedAt    DateTime?
  claimNotes   String?

  // WhatsApp Automation
  whatsappSent      Boolean   @default(false)
  whatsappSentAt    DateTime?
  whatsappStatus    String?
  whatsappMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lost_items")
}

// ========================================
// SYSTEM CONFIGURATION
// ========================================

model RolePermission {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToRolePermission", fields: [propertyId], references: [id], onDelete: Cascade)

  role        UserRole
  permissions Json // Map of permissions: { "rooms": "READ_WRITE", "payroll": "NONE", etc. }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, role])
  @@map("role_permissions")
}

model SystemSetting {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  key         String  @unique
  value       String
  description String?

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model NotificationTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name    String              @unique
  type    NotificationType
  channel NotificationChannel

  subject  String? // For email
  template String // Template content with variables

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model ServiceConfig {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String        @db.ObjectId
  property   Property      @relation("PropertyToServiceConfig", fields: [propertyId], references: [id], onDelete: Cascade)
  type       ServiceType
  steps      ServiceStep[]
  totalSla   Int // Total SLA in minutes
  options    Json? // Dynamic options for guests (e.g. types of cleaning)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([propertyId, type])
  @@map("service_configs")
}

model ServiceStep {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  serviceConfigId String        @db.ObjectId
  serviceConfig   ServiceConfig @relation(fields: [serviceConfigId], references: [id], onDelete: Cascade)
  name            String // e.g., "Cooking", "Staff Transfer"
  duration        Int // Duration in minutes
  order           Int // Position in the path

  @@map("service_steps")
}

enum NotificationType {
  CHECK_IN_LINK
  BOOKING_CONFIRMATION
  CHECK_IN_REMINDER
  CHECK_OUT_REMINDER
  SERVICE_REQUEST_UPDATE
  PAYMENT_RECEIPT
  STAFF_TASK_ASSIGNED
  LEAVE_APPROVED
  SALARY_CREDITED
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  PUSH
  IN_APP
