  propertyId String   @db.ObjectId
  property   Property @relation("PropertyToAuditRun", fields: [propertyId], references: [id], onDelete: Cascade)
  
  auditDate  DateTime
  status     AuditStatus @default(IN_PROGRESS) // IN_PROGRESS, COMPLETED, FAILED
  
  startedById String  @db.ObjectId
  startedBy   User    @relation("UserToAuditRunStarted", fields: [startedById], references: [id])
  
  closedAt   DateTime?
